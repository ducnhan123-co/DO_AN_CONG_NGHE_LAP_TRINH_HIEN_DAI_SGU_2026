# Sao chép thành backend/.env rồi chỉnh. Mọi giá trị đều có mặc định.

# --- Thư mục dự án rag_toan (để trống để tự tìm cạnh backend/) ---
RAG_TOAN_DIR=

# --- MinerU ---
MINERU_CMD=mineru-kit
MINERU_TIER=advanced          # giống rag_toan/src/config.py
MINERU_FORMAT=markdown        # markdown hoặc zip
MINERU_OCR_MODE=auto
MINERU_WORKERS=2              # số tiến trình MinerU song song trên một PDF
MINERU_MIN_PAGES_PER_WORKER=5 # PDF ngắn tự giảm số tiến trình
MINERU_STAGGER_S=20           # giãn thời điểm khởi chạy tiến trình MinerU

# --- Khác ---
MAX_UPLOAD_MB=100
PANDOC_TIMEOUT_S=900
LOG_LEVEL=INFO