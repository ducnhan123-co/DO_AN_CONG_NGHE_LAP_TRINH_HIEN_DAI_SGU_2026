# Sao chép thành .env rồi chỉnh. Mọi biến đều tùy chọn (đã có mặc định như main.py của rag_toan).
PORT=8000
DATA_DIR=./data
# Nếu frontend chạy ở domain khác (vd Vercel): liệt kê, cách nhau bằng dấu phẩy. "*" = cho mọi nơi.
CORS_ORIGINS=*
MAX_UPLOAD_MB=100

# Số tài liệu chạy cùng lúc / số tiến trình MinerU cho mỗi tài liệu / giây chờ giữa các tiến trình
MAIN_SLOTS=1
MINERU_WORKERS=2
MINERU_STAGGER=20
MINERU_TIER=advanced
MINERU_CMD=mineru-kit
# Dùng dịch vụ MinerU từ xa thay vì model cục bộ (nhẹ máy hơn; CHƯA kiểm thử với bản này):
# MINERU_EXTRA_ARGS=--remote --api-key XXXX

# Dev không cần model: MINERU_CMD="python tests/fake_mineru_kit.py"
RAG_ARTIFACTS=1
RAG_INDEX=0
