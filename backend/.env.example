MAX_UPLOAD_MB=50
TOP_K=5
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# LLM_BACKEND: none | qwen_local | ollama
LLM_BACKEND=none
# LLM_NAME=            # để trống thì dùng LLM_NAME trong src/config.py
PRELOAD_LLM=false
# Prewarm must be explicitly enabled on hosts with sufficient RAM
EMBED_PREWARM=false
MINERU_PREWARM=false
# Set false on Render Free; full MinerU + E5 + Qwen cannot fit within 512 MB.
# API continues to serve health/docs; uploads are rejected clearly with HTTP 503.
AI_PIPELINE_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
