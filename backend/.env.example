MAX_UPLOAD_MB=50
TOP_K=5
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# Mac native uses the AI pipeline; Render Free safe mode is API-only.
AI_PIPELINE_ENABLED=false
MINERU_PREWARM=false
SERVE_FRONTEND=false

# Kiệt CLI runner on Mac; Render Free must keep AI_PIPELINE_ENABLED=false.
KIET_CLI_ENABLED=true
KIET_TIER=advanced
KIET_TIMEOUT_S=3600
# FastAPI accepts upload/jobs only; it runs kiet_cli.py via subprocess, no extra API.
