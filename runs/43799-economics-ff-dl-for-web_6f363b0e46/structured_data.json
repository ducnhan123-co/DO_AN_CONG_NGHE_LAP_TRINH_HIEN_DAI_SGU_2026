    "page": null,
    "section": "Economics Facts & Formulae",
    "content_type": "text",
    "text": "**math**centre is a project offering students and staff free resources to support the transition from school mathematics to university mathematics.",
    "formula_latex": null,
    "image_path": null
  },
  {
    "block_id": 36,
    "doc_id": "6f363b0e46",
    "source": "43799-economics-ff-dl-for-web.pdf",
